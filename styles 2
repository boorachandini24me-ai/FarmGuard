:root{--green:#1d6b42;--green2:#2e8b57;--mint:#eaf6ed;--cream:#f8f7f1;--ink:#193329;--muted:#718078;--line:#dce6df;--white:#fff;--shadow:0 18px 50px rgba(25,51,41,.09)}
*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,-apple-system,Segoe UI,sans-serif;color:var(--ink);background:var(--cream)}button,input{font:inherit}button{cursor:pointer;border:0}.hidden{display:none!important}
.topbar{height:76px;background:#fff;border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 6%;position:sticky;top:0;z-index:5}.brand{display:flex;gap:10px;align-items:center}.brand b{display:block;font-size:20px}.brand small{color:var(--muted);font-size:11px}.logo{font-size:31px}.topbar nav{display:flex;gap:7px;align-items:center}.topbar nav button{background:transparent;padding:10px 13px;color:#486057;border-radius:9px}.topbar nav button:hover{background:var(--mint)}.outline{border:1px solid var(--line)!important}
main{max-width:1180px;margin:auto}.auth-wrap{min-height:calc(100vh - 76px);display:grid;place-items:center;padding:35px}.auth-card{width:min(900px,100%);background:white;border-radius:25px;overflow:hidden;box-shadow:var(--shadow);display:grid;grid-template-columns:1fr 1fr}.auth-hero{padding:65px 55px;background:linear-gradient(145deg,#e7f5e9,#cfead4);position:relative}.big-leaf{font-size:58px}.auth-hero h1{font-size:42px;line-height:1.05;margin:24px 0 15px}.auth-hero h1 span,.hero h1 span{color:var(--green2)}.auth-hero p{color:#53675d;line-height:1.7}.auth-form{padding:55px}.tabs{display:flex;border-bottom:1px solid var(--line);margin-bottom:25px}.tabs button{background:transparent;padding:12px 20px;color:var(--muted);font-weight:700}.tabs .active{color:var(--green);border-bottom:2px solid var(--green)}
label{display:block;font-size:13px;font-weight:700;margin:16px 0}input{width:100%;border:1px solid var(--line);border-radius:10px;padding:13px 14px;margin-top:7px;background:#fff;outline:none}input:focus{border-color:var(--green2)}.primary{background:var(--green);color:#fff;padding:13px 20px;border-radius:10px;font-weight:800;box-shadow:0 8px 20px rgba(29,107,66,.18)}.primary:hover{background:#165b37}.secondary{background:white;border:1px solid var(--line);padding:11px 18px;border-radius:9px;font-weight:700;color:var(--green)}.wide{width:100%}.muted{color:var(--muted);font-size:12px}.center{text-align:center}
.view{padding:42px 5% 70px}.hero{min-height:480px;display:grid;grid-template-columns:1.15fr .85fr;align-items:center;gap:20px}.pill{display:inline-block;background:#dff1e4;color:var(--green);font-weight:800;font-size:11px;padding:7px 11px;border-radius:30px;letter-spacing:.8px}.hero h1{font-size:57px;line-height:1.03;margin:20px 0}.hero p{max-width:570px;line-height:1.8;color:var(--muted);font-size:16px}.hero-art{font-size:160px;text-align:center;position:relative}.hero-art span{font-size:55px;display:inline-block;transform:translateY(40px)}.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:15px}.stats>div,.steps>div,.upload-card,.result-card,.profile-card,.product,.history-item{background:#fff;border:1px solid var(--line);border-radius:17px;padding:22px}.stats b{font-size:25px;display:block}.stats strong,.stats small{display:block;margin-top:8px}.stats small,.steps p{color:var(--muted);font-size:13px}.section-head{margin:70px 0 22px}.eyebrow{font-size:11px;color:var(--green2);font-weight:900;letter-spacing:1.5px}.section-head h2,.page-head h1{margin:7px 0;font-size:32px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}.steps i{font-style:normal;color:var(--green2);font-weight:900}.page-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:28px}.page-head p{color:var(--muted);margin:6px 0}.search{max-width:260px}.scan-grid{display:grid;grid-template-columns:1fr 1fr;gap:20px}.drop-zone{min-height:360px;border:2px dashed #bdd4c3;border-radius:15px;display:grid;place-content:center;text-align:center;padding:30px}.upload-icon{font-size:48px}.drop-zone p{color:var(--muted);font-size:13px}.preview{width:100%;max-height:390px;object-fit:contain;border-radius:15px;background:#f3f5f2}.scanActions{margin-top:12px}.text-btn{background:transparent;color:var(--muted);padding:10px}.result-card{min-height:430px}.empty-result{text-align:center;margin-top:100px;color:var(--muted)}.empty-result span{font-size:55px}.diagnosis h2{margin:6px 0}.confidence{background:#e8f4ea;color:var(--green);padding:7px 10px;border-radius:8px;display:inline-block;font-weight:800;font-size:12px}.treatment{background:#f5faf6;padding:16px;border-radius:12px;margin-top:16px}.product-grid,.products-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:17px}.product h3{margin:10px 0 5px}.product .type{font-size:11px;color:var(--green2);font-weight:800}.product p{color:var(--muted);font-size:13px;line-height:1.6}.price{font-weight:900;font-size:18px}.notice{margin-top:25px;padding:15px;background:#fff6dc;border:1px solid #f1dfaa;border-radius:12px;font-size:13px;color:#6d5b25}.history-list{display:grid;gap:12px}.history-item{display:flex;gap:18px;align-items:center}.history-item img{width:85px;height:70px;object-fit:cover;border-radius:10px}.history-item h3{margin:0}.history-item p{margin:5px 0;color:var(--muted);font-size:13px}.profile-card{display:flex;align-items:center;gap:20px}.avatar{width:75px;height:75px;border-radius:50%;background:var(--mint);display:grid;place-items:center;font-size:37px}
#toast{position:fixed;right:20px;bottom:20px;background:#173b2c;color:white;padding:13px 18px;border-radius:10px;z-index:20;display:none}
@media(max-width:800px){.topbar{padding:0 4%}.topbar nav{display:none}.mobile-only{display:block!important}.auth-card,.hero,.scan-grid{grid-template-columns:1fr}.auth-hero{padding:40px}.auth-form{padding:35px}.hero{padding:20px 0}.hero h1{font-size:43px}.hero-art{font-size:100px}.stats,.steps,.products-grid{grid-template-columns:1fr 1fr}.page-head{align-items:start;gap:15px;flex-direction:column}.search{max-width:none}.view{padding:30px 4%}}
@media(max-width:520px){.stats,.steps,.products-grid{grid-template-columns:1fr}.auth-hero h1{font-size:34px}}

.menu-wrap{position:relative;margin-left:8px}
.menu-btn{width:44px;height:44px;border-radius:10px;background:transparent;display:flex;flex-direction:column;justify-content:center;align-items:center;gap:5px}
.menu-btn:hover{background:var(--mint)}
.menu-btn span{display:block;width:22px;height:2.5px;background:var(--ink);border-radius:2px}
.menu-drop{position:absolute;right:0;top:52px;min-width:210px;background:#fff;border:1px solid var(--line);border-radius:14px;box-shadow:var(--shadow);padding:8px;z-index:30}
.menu-drop button{display:block;width:100%;text-align:left;background:transparent;padding:12px 14px;border-radius:9px;color:var(--ink);font-weight:600}
.menu-drop button:hover{background:var(--mint)}
.mobile-only{display:none}
.topbar nav{margin-left:auto}
.searchbar{display:flex;align-items:center;gap:10px;background:#fff;border:1px solid var(--line);border-radius:14px;padding:4px 14px;margin-bottom:10px;box-shadow:0 6px 18px rgba(25,51,41,.05)}
.searchbar:focus-within{border-color:var(--green2)}
.searchbar input{border:0;margin:0;padding:13px 4px;flex:1;min-width:0}
.searchbar button{background:transparent;color:var(--muted);font-size:16px;padding:6px}
.no-results{grid-column:1/-1;text-align:center;color:var(--muted);padding:40px 0}
.settings-card{background:#fff;border:1px solid var(--line);border-radius:17px;padding:6px 22px;max-width:640px}
.setting{display:flex;justify-content:space-between;align-items:center;gap:16px;padding:18px 0;border-bottom:1px solid var(--line)}
.setting:last-child{border-bottom:0}.setting h3{margin:0}.setting p{margin:4px 0 0;color:var(--muted);font-size:13px}
.switch{position:relative;width:48px;height:28px;flex:none;margin:0}
.switch input{opacity:0;position:absolute;width:100%;height:100%;margin:0;padding:0;cursor:pointer;z-index:1}
.switch i{position:absolute;inset:0;background:#cfd9d2;border-radius:20px;transition:.2s}
.switch i:before{content:"";position:absolute;left:3px;top:3px;width:22px;height:22px;background:#fff;border-radius:50%;transition:.2s}
.switch input:checked+i{background:var(--green2)}.switch input:checked+i:before{transform:translateX(20px)}
body.big-text{font-size:19px}
body.dark{--cream:#0f1a15;--ink:#e6f0ea;--muted:#9bb0a4;--line:#26382f;--mint:#1b2d24;--shadow:0 18px 50px rgba(0,0,0,.4)}
body.dark .topbar,body.dark .auth-card,body.dark .stats>div,body.dark .steps>div,body.dark .upload-card,body.dark .result-card,body.dark .profile-card,body.dark .product,body.dark .history-item,body.dark .settings-card,body.dark .searchbar,body.dark .menu-drop,body.dark input,body.dark .secondary{background:#16231c;color:var(--ink)}
body.dark .auth-hero{background:linear-gradient(145deg,#1b2d24,#14241c)}
body.dark .treatment,body.dark .preview{background:#1b2d24}
body.dark .searchbar input{background:transparent}
body.dark .topbar nav button{color:var(--ink)}
